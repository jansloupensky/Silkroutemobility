# ==========================================================================
# silkroutemobility.com – Apache
# Každé pravidlo je v <IfModule>, aby web nespadl na hostingu bez daného modulu.
# ==========================================================================

# Pozn.: „Options -Indexes“ záměrně chybí – na části hostingů (AllowOverride bez Options) by způsobilo chybu 500.
<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>

# --------------------------------------------------------------- chybové stránky
ErrorDocument 404 /404.html
# <If> existuje až v Apache 2.4 – proto obaleno kontrolou verze
<IfModule mod_version.c>
  <IfVersion >= 2.4>
    <If "%{REQUEST_URI} =~ m#^/sk/#">
      ErrorDocument 404 /sk/404.html
    </If>
    <If "%{REQUEST_URI} =~ m#^/en/#">
      ErrorDocument 404 /en/404.html
    </If>
  </IfVersion>
</IfModule>

# ------------------------------------------------- HTTPS a doména bez www (301)
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ---------------------------------------- staré URL z WordPressu → úvod (301)
  # /?p=123, /?page_id=2, /?cat=1 …
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|m|s|feed)= [NC]
  RewriteRule ^$ /? [R=301,L]

  RewriteRule ^sample-page/?$ / [R=301,L,NC]
  RewriteRule ^ukazkova-stranka/?$ / [R=301,L,NC]
  RewriteRule ^wp-admin(/.*)?$ / [R=301,L,NC]
  RewriteRule ^wp-login\.php$ / [R=301,L,NC]
  RewriteRule ^wp-content(/.*)?$ / [R=301,L,NC]
  RewriteRule ^wp-includes(/.*)?$ / [R=301,L,NC]
  RewriteRule ^xmlrpc\.php$ / [R=301,L,NC]
  RewriteRule ^wp-json(/.*)?$ / [R=301,L,NC]
  RewriteRule ^feed(/.*)?$ / [R=301,L,NC]
  RewriteRule ^comments/feed(/.*)?$ / [R=301,L,NC]
  RewriteRule ^category(/.*)?$ / [R=301,L,NC]
  RewriteRule ^tag(/.*)?$ / [R=301,L,NC]
  RewriteRule ^author(/.*)?$ / [R=301,L,NC]
  RewriteRule ^20[0-9]{2}(/.*)?$ / [R=301,L,NC]

  # /index.html → / (čisté URL bez duplicit)
  RewriteCond %{THE_REQUEST} \s/((?:sk/|en/)?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# Záloha bez mod_rewrite (mod_alias) – jen přesměrování starých WP cest
<IfModule !mod_rewrite.c>
  <IfModule mod_alias.c>
    RedirectMatch 301 ^/(sample-page|ukazkova-stranka|feed|category|tag|author|wp-admin|wp-content|wp-includes|wp-json)(/.*)?$ /
    RedirectMatch 301 ^/(wp-login|xmlrpc)\.php$ /
    RedirectMatch 301 ^/20[0-9]{2}(/.*)?$ /
  </IfModule>
</IfModule>

# ---------------------------------------------------------------- MIME typy
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType application/manifest+json .webmanifest
  AddCharset utf-8 .html .css .js .xml .txt .md .webmanifest .svg
</IfModule>

# ----------------------------------------------------------------- komprese
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/xml text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ------------------------------------------------------------------- cache
# /assets/ soubory s hashem v názvu (main.1a2b3c4d.css …) se nikdy nemění → 1 rok.
# Obrázky a videa bez hashe (majitel je vyměňuje pod stejným názvem) → 1 týden.
# HTML → krátce, vždy ověřit.
<IfModule mod_headers.c>
  <FilesMatch "\.[0-9a-f]{8}\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpe?g|png|svg|webm|mp4|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 5 minutes"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/avif "access plus 1 week"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType video/mp4 "access plus 1 week"
  ExpiresByType video/webm "access plus 1 week"
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>

# ------------------------------------------------------ bezpečnostní hlavičky
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # CSP: obsah jen z vlastní domény. Hash inline skriptu doplňuje build automaticky – NEUPRAVOVAT ručně v dist/.
  Header always set Content-Security-Policy "{{CSP}}"
  # HSTS zapněte až po ověření, že HTTPS funguje na celé doméně:
  # Header always set Strict-Transport-Security "max-age=31536000"
  Header unset X-Powered-By
</IfModule>

# Skryté a systémové soubory nevydávat
<IfModule mod_authz_core.c>
  <FilesMatch "^\.|\.(bak|log|md|json\.bak)$">
    Require all denied
  </FilesMatch>
</IfModule>
